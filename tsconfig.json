{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": "./src",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "noImplicitAny": false,
        "strictPropertyInitialization": false,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    }
}